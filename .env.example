EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_INTERNAL_API_KEY=your-internal-api-key-here
# Stripe — use pk_test_... for sandbox, pk_live_... for production
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
# RevenueCat — get keys from app.revenuecat.com → Project Settings → API Keys
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_your-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-public-sdk-key
# Sentry — create a React Native project at sentry.io → Settings → Client Keys (DSN)
# Leave empty to disable; set in production to enable native crash reporting
EXPO_PUBLIC_SENTRY_DSN=
